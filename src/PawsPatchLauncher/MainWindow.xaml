                                                    <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="60"/></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Text, ElementName=OperationText}" ToolTip="{Binding Text, ElementName=OperationText}" Foreground="{StaticResource TextMainBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TransferText" Grid.Row="1" Style="{StaticResource MetadataText}" Visibility="Collapsed" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="17" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <Button x:Name="CancelDownloadButton" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Padding="9,5" Click="CancelDownload_Click"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="ErrorActionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                            <Button x:Name="ErrorActionButton" Style="{StaticResource GhostButton}" FontSize="12" Padding="8,6" Click="ErrorAction_Click"/>
                                            <Button x:Name="ErrorDetailsButton" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,6" Margin="0,7,0,0" Click="ErrorDetails_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                    <ContentControl x:Name="OperationFooterHost"/>
                    <TextBlock x:Name="GameCompatibilityHint" Visibility="Collapsed" Foreground="#FF9D9D" TextWrapping="Wrap" HorizontalAlignment="Right" MaxWidth="580" Margin="0,0,0,10" FontSize="12"/>
                    <Grid x:Name="ActionBar">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="UpdateButton" Grid.Row="1" Style="{StaticResource GoldButton}" Click="UpdateButton_Click"/>
                        <Button x:Name="CheckUpdatesButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="CheckUpdatesButton_Click"/>
                        <Button x:Name="ApplySettingsButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource GoldButton}" Margin="10,0,10,0" Visibility="Collapsed" Click="ApplySettingsButton_Click"/>
                        <Button x:Name="LaunchButton" Grid.Row="1" Grid.Column="4" Style="{StaticResource GoldButton}" Padding="30,11" Click="LaunchButton_Click"/>
                    </Grid>
                    </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="HelpOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#D907101F" Visibility="Collapsed" PreviewMouseDown="Overlay_MouseDown" PreviewKeyDown="HelpOverlay_KeyDown" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Border x:Name="HelpCard" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" Width="520" MaxWidth="520" Background="#132541" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="9" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#3B5375" BorderBrush="{StaticResource GoldBrightBrush}" BorderThickness="1" Margin="0,0,12,0">
                                    <local:LauncherIcon Kind="Help" Foreground="{StaticResource GoldBrightBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="HelpTitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="HelpBodyText" Foreground="#D5DDE8" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,18,0,20"/>
                            <Button x:Name="HelpCloseButton" Style="{StaticResource GoldButton}" HorizontalAlignment="Right" Padding="22,9" Click="HelpCloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="GameSettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="800" Background="#D907101F" Visibility="Collapsed"
                    WindowChrome.IsHitTestVisibleInChrome="True" PreviewMouseDown="GameSettings_MouseDown" PreviewKeyDown="GameSettings_KeyDown">
                <Border x:Name="GameSettingsCard" MaxWidth="710" MaxHeight="740" Margin="24" Padding="24" CornerRadius="14" Background="#11243B"
                        BorderBrush="#536F8E" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock x:Name="GameSettingsTitle" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="GameSettingsHint" Style="{StaticResource CardDescription}" Margin="0,12,0,0"/>
                            </StackPanel>
                            <Button x:Name="GameSettingsClose" Grid.Column="1" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="8" VerticalAlignment="Top" Click="GameSettingsCancel_Click">
                                <local:LauncherIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <ScrollViewer x:Name="GameSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                            <StackPanel x:Name="GameSettingsBody"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="GameSettingsStatus" Style="{StaticResource CardDescription}" Foreground="#F4C877" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="GameSettingsCancel" Style="{StaticResource GhostButton}" Padding="18,9" Margin="0,0,8,0" Click="GameSettingsCancel_Click"/>
                                <Button x:Name="GameSettingsSave" Style="{StaticResource GoldButton}" Padding="22,9" Click="GameSettingsSave_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
            <Border x:Name="ConfirmationOverlay" Grid.RowSpan="2" Panel.ZIndex="200" Background="#B807101F" Visibility="Collapsed"
                    WindowChrome.IsHitTestVisibleInChrome="True" PreviewMouseDown="Overlay_MouseDown">
                <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                    <Border x:Name="ConfirmationCard" MaxWidth="620" Background="#132541" BorderBrush="#AD8150" BorderThickness="1" CornerRadius="12" Padding="26"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <Border x:Name="ConfirmationIconBadge" Width="42" Height="42" CornerRadius="12" Background="#432E35" BorderBrush="#87565A" BorderThickness="1" VerticalAlignment="Top">
                                    <local:LauncherIcon x:Name="ConfirmationActionIcon" Kind="Trash" Width="23" Height="23" Foreground="#F3AA96"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConfirmationEyebrowText" Style="{StaticResource MetadataText}" Foreground="{StaticResource GoldBrightBrush}" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="ConfirmationTitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ConfirmationCloseButton" Grid.Column="2" Style="{StaticResource TitleButton}" Width="30" Height="30" Padding="0" VerticalAlignment="Top" Click="ConfirmationCancel_Click"><local:LauncherIcon Kind="Close"/></Button>
                            </Grid>
                            <TextBlock x:Name="ConfirmationBodyText" Grid.Row="1" Foreground="#D5DDE8" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,20,0,18"/>
                            <Border Grid.Row="2" Background="#0B192C" BorderBrush="#3D5473" BorderThickness="1" CornerRadius="6" Padding="13,11">
                                <StackPanel>
                                    <TextBlock x:Name="ConfirmationPathLabel" Style="{StaticResource MetadataText}" Margin="0,0,0,6"/>
                                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock x:Name="ConfirmationPathText" FontSize="13" LineHeight="21" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="ConfirmationChangesPanel" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <CheckBox x:Name="ConfirmationRemoveModsToggle" Visibility="Collapsed" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button x:Name="ConfirmationCancelButton" Style="{StaticResource GhostButton}" IsDefault="True" Padding="20,10" Margin="0,0,10,0" Click="ConfirmationCancel_Click"/>
                                <Button x:Name="ConfirmationDeleteButton" Style="{StaticResource GhostButton}" Background="#653A38" BorderBrush="#BC7967" Foreground="#FFF0E8"
                                        local:Motion.HoverBackground="#854D43" local:Motion.PressedBackground="#542F2F" local:LauncherIcon.Kind="Trash" Padding="20,10" Click="ConfirmationDelete_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer x:Name="ToastHost" Grid.RowSpan="2" Panel.ZIndex="1000" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          MaxWidth="600" MaxHeight="420" Margin="24,0,24,76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ToastStack">
            <Border x:Name="ToastPanel" Visibility="Collapsed" MaxWidth="580" MinWidth="300" Margin="0,0,0,8"
                    Background="#142F28" BorderBrush="#4D9B75" BorderThickness="1" CornerRadius="10">
                <Border.RenderTransform><TranslateTransform x:Name="ToastSlide"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <local:LauncherIcon x:Name="ToastIcon" Kind="Check"/>
                        <TextBlock x:Name="ToastText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Margin="6,0,14,0"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        <Border x:Name="ToastCountBadge" Grid.Column="2" Visibility="Collapsed" Background="#1CFFFFFF" CornerRadius="5"
                                Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <TextBlock x:Name="ToastCountText" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="ToastCloseButton" Grid.Column="3" Style="{StaticResource TitleButton}"
                                Padding="0" Width="26" Height="28" VerticalAlignment="Center" Click="ToastCloseButton_Click"><local:LauncherIcon Kind="Close" Width="16" Height="16"/></Button>
                    </Grid>
                    <Border x:Name="ToastProgress" Grid.Row="1" Background="#6DCCA5" CornerRadius="1" Margin="9,0,9,0" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="ToastProgressScale" ScaleX="0"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
