<Window x:Class="PawsPatchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PawsPatchLauncher"
        Title="Kohan II Launcher" Width="1600" Height="1000" MinWidth="1050" MinHeight="680"
        FontFamily="Arial" Icon="Assets/K2Launcher.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource NightBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Toggle semantics/keyboard access without a checkbox glyph: the whole card is the target. -->
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07101F" Offset="0"/>
            <GradientStop Color="#0A1930" Offset="0.52"/>
            <GradientStop Color="#07101F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B2132541"/>
            <Setter Property="BorderBrush" Value="#3D5473"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock" BasedOn="{StaticResource CardSubtitle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetadataText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SmallMetadataText" TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ConfigurationInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1729"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#405878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" CornerRadius="5"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="#7892B3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="local:Motion.Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="BorderBrush" Value="#60738D"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#162A45"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="ReleaseCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" local:Motion.Background="#1B304D" local:Motion.BorderBrush="#60738D" BorderThickness="1" CornerRadius="4" Padding="9,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="▾" HorizontalAlignment="Right" Foreground="{StaticResource GoldBrightBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="local:Motion.Background" Value="#304867"/>
                                                <Setter TargetName="ComboBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" local:PopupScrollIsolation.Enabled="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#162A45" BorderBrush="#60738D" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="#1B304D"/>
            <Setter Property="BorderBrush" Value="#526984"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter local:Motion.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="local:Motion.Background" Value="#4A3C20"/>
                                <Setter TargetName="ModeBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeBorder" Property="local:Motion.Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PatchChannelChoice" TargetType="RadioButton" BasedOn="{StaticResource ModeRadio}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#594A2A" BorderThickness="1" Background="{StaticResource WindowBackground}">
        <Grid x:Name="WindowLayers">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="#B00A1425">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="K O H A N   I I   L A U N C H E R" FontWeight="Bold" FontSize="12" Foreground="{StaticResource GoldBrightBrush}"/>
                    <TextBlock Text="  /  KOHAN II" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LauncherUpdateButton" Visibility="Collapsed" Height="32" Margin="0,7,12,7" Style="{StaticResource GoldButton}" Padding="12,4" Click="LauncherUpdateButton_Click"/>
                    <Button x:Name="LanguageButton" Visibility="Collapsed" Width="58" Height="32" Margin="0,7,6,7" Style="{StaticResource GhostButton}" Padding="4" Click="LanguageButton_Click">EN</Button>
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource TitleButton}" Width="42" Height="46" Click="MinimizeButton_Click"><local:LauncherIcon Kind="Minimize"/></Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource TitleButton}" local:Motion.HoverBackground="#753B43" local:Motion.PressedBackground="#512730" Width="46" Height="46" Click="CloseButton_Click"><local:LauncherIcon Kind="Close"/></Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainBody" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#A90A1528" BorderBrush="#344967" BorderThickness="0,0,1,0">
                    <Grid Margin="18,26,18,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="BrandGapRow" Height="36"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image x:Name="BrandMark" Source="{StaticResource AppMark}" Width="108" Height="108" HorizontalAlignment="Center"
                               AutomationProperties.Name="Kohan II Launcher"/>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="HomeNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="HomeNav_Click"/>
                            <Grid Margin="0,0,0,8">
                                <Button x:Name="ModulesNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="ModulesNav_Click"/>
                                <Border x:Name="ModulesNavBadge" Background="#B94757" CornerRadius="9" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Button x:Name="ModManagerNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="ModManagerNav_Click"/>
                            <Button x:Name="SettingsNav" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="SettingsNav_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4">
                            <TextBlock x:Name="LauncherVersionLabel" Style="{StaticResource SmallMetadataText}" Foreground="#708098"/>
                            <TextBlock x:Name="LauncherVersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                            <TextBlock x:Name="InstalledPatchLabel" Style="{StaticResource SmallMetadataText}" Foreground="#708098" Margin="0,12,0,0"/>
                            <TextBlock x:Name="InstalledPatchText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InstalledGameLabel" Style="{StaticResource SmallMetadataText}" Foreground="#708098" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock x:Name="InstalledGameText" FontSize="13" VerticalAlignment="Center"/>
                                <Button x:Name="GameCompatibilityButton" Style="{StaticResource GhostButton}" Foreground="#FFD0D8" Background="#542E3A" Width="24" Height="24" Padding="0" Margin="8,0,0,0" Visibility="Collapsed" Click="GameCompatibility_Click"><TextBlock Text="!" FontWeight="Bold" FontSize="16"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="WorkspaceBody" Grid.Column="1" Margin="30,12,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="WorkspaceHeader" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="26" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border x:Name="ReadyStatusBadge" Grid.Column="1" CornerRadius="14" Background="#193926" BorderBrush="#3F8D64" BorderThickness="1" Padding="14,6" VerticalAlignment="Center" MaxWidth="270" Margin="12,0,0,0">
                            <TextBlock x:Name="ReadyStatusText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <Button x:Name="HistoryButton" Grid.Column="2" Width="38" Height="38" Margin="12,0,0,0" Padding="0" Style="{StaticResource GhostButton}" Click="HistoryButton_Click">
                            <Grid><local:LauncherIcon Kind="ReleaseNotes" Width="21" Height="21"/>
                                <Ellipse x:Name="HistoryButtonBadge" Width="7" Height="7" Fill="{StaticResource GoldBrightBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <Grid x:Name="CommunityWorkspace" Grid.Row="2" Grid.RowSpan="3">
                        
                        <Grid x:Name="PagesWorkspace" SizeChanged="PagesWorkspace_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OptionsColumn" Width="1.6*"/>
                            <ColumnDefinition x:Name="OptionsGapColumn" Width="0"/>
                            <ColumnDefinition x:Name="NewsColumn" Width="0"/>
                        </Grid.ColumnDefinitions>


                        <Grid x:Name="MainOptionsHost" Grid.Column="0" Grid.ColumnSpan="3">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel x:Name="PinnedComponentsHost" Visibility="Collapsed" Margin="0,0,12,0"/>
                        <ScrollViewer x:Name="MainOptionsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
                            <StackPanel Margin="0,0,12,0">
                                <StackPanel x:Name="ModManagerPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ModManagerTitleText" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                <Button x:Name="CustomModsAdd" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,7" VerticalAlignment="Center" Margin="12,0,0,8" Click="CustomModsAdd_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="ModManagerDescriptionText" Style="{StaticResource CardDescription}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="ModManagerGamesTitleText" Style="{StaticResource FieldTitle}"/>
                                            <TextBlock x:Name="ModManagerGamesDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                            <StackPanel x:Name="ModManagerGamesBody" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="ModManagerOrderTitleText" Style="{StaticResource FieldTitle}"/>
                                            <StackPanel x:Name="CustomModsBody" Margin="0,10,0,0"/>
                                            <!-- The single-player sandbox: a switch in the mod list, not an RWD (no load order, nothing to remove). -->
                                            <Border x:Name="SandboxCard" Padding="12" Margin="0,0,0,8" CornerRadius="7" Background="#172F46" BorderBrush="#3B546D" BorderThickness="1" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#1B2C40" BorderBrush="#3B546D" BorderThickness="1"><local:LauncherIcon Kind="Bot" Width="16" Height="16" Foreground="{StaticResource GoldBrightBrush}"/></Border>
                                                    <CheckBox x:Name="SandboxToggle" Grid.Column="1" VerticalAlignment="Center" Margin="0" Click="SandboxToggle_Click" AutomationProperties.Name="Sandbox"/>
                                                    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="SandboxTitleText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="SandboxDescriptionText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="ModManagerStatusText" Style="{StaticResource CardDescription}" Foreground="#F4C877" Margin="0,4,0,0" Visibility="Collapsed"/>
                                            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button x:Name="ModManagerComponentsButton" Style="{StaticResource GhostButton}" Padding="16,9" Margin="0,0,8,0" Visibility="Collapsed" Click="ModManagerComponents_Click"/>
                                                <Button x:Name="ModManagerRevert" Style="{StaticResource GhostButton}" Padding="18,9" Margin="0,0,8,0" Click="ModManagerRevert_Click"/>
                                                <Button x:Name="ModManagerApply" Style="{StaticResource GoldButton}" Padding="22,9" Click="ModManagerApply_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="ModManagerMultiplayerText" Style="{StaticResource CardDescription}" Margin="4,0,4,14"/>
                                </StackPanel>
                                <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="SettingsTitleText" Style="{StaticResource CardTitle}"/>
                                        <Border x:Name="InterfaceLanguageCard" HorizontalAlignment="Left" Background="#142B44" BorderBrush="#344E69" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,4,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                    <local:LauncherIcon Kind="Language" Width="21" Height="21" Foreground="{StaticResource GoldBrightBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock x:Name="SettingsLanguageTitleText" Style="{StaticResource FieldTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="SettingsLanguageButton" Visibility="Collapsed" Click="LanguageButton_Click"/>
                                                <ComboBox x:Name="LauncherLanguageCombo" MinWidth="230" HorizontalAlignment="Stretch" Style="{StaticResource ReleaseCombo}" DisplayMemberPath="Label" SelectionChanged="LauncherLanguage_Changed"/>
                                                <TextBlock x:Name="SettingsLanguageDescriptionText" Visibility="Collapsed" Style="{StaticResource CardDescription}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="LauncherUpdatesDescriptionText" Style="{StaticResource CardDescription}" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PatchUpdatesCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="PatchUpdatesTitleText" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="PatchChannelDescriptionText" Style="{StaticResource CardDescription}" Margin="0,0,0,4"/>
                                        <Separator Margin="0,16,0,13" Background="#40536E"/>
                                        <TextBlock x:Name="SettingsRepairTitleText" Style="{StaticResource FieldTitle}"/>
                                        <TextBlock x:Name="SettingsRepairDescriptionText" Style="{StaticResource CardDescription}" Margin="0,4,0,0"/>
                                        <Button x:Name="SettingsRepairButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,11,0,0" Padding="14,7" Click="RepairButton_Click"/>
                                        <Separator Margin="0,16,0,13" Background="#40536E"/>
                                        <TextBlock x:Name="SettingsUpdatesDescriptionText" Style="{StaticResource CardDescription}"/>
                                        <TextBlock x:Name="LastCheckedText" Style="{StaticResource SmallMetadataText}" Foreground="#71819A" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConfigurationCodeCard" Style="{StaticResource Card}" Margin="0,0,0,9" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock x:Name="ConfigurationTitleText" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource HelpButton}" Tag="configuration" Margin="8,0,0,0" VerticalAlignment="Center" Click="HelpButton_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ConfigurationDescriptionText" Style="{StaticResource CardDescription}"/>
                                        <Border Background="#0A1729" BorderBrush="#405878" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,10,0,9">
                                            <TextBlock x:Name="ConfigurationCodeText" Foreground="{StaticResource GoldBrightBrush}" TextWrapping="Wrap"/>
                                        </Border>
                                        <local:ClipboardButton x:Name="CopyConfigurationButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,7" Click="CopyConfigurationButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ConfigurationImportHost" Visibility="Collapsed"/>
                                <StackPanel x:Name="ReliabilityPanels"/>
                                <Border x:Name="HomeWelcomeCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="HomeWelcomeTitleText" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="HomeWelcomeBodyText" Style="{StaticResource CardDescription}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UpdateNoticeBorder" Style="{StaticResource Card}" BorderBrush="{StaticResource GoldBrush}" Background="#B23A321D" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateNoticeTitleText" Style="{StaticResource CardTitle}" Foreground="{StaticResource GoldBrightBrush}"/>
                                        <TextBlock x:Name="UpdateNoticeBodyText" Style="{StaticResource CardDescription}" Foreground="#E7DFC9"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock x:Name="DiagnosticsTitleText" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource HelpButton}" Tag="diagnostics" Margin="8,0,0,0" VerticalAlignment="Center" Click="HelpButton_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsDescriptionText" Style="{StaticResource CardDescription}"/>
                                        <WrapPanel Margin="0,11,0,0">
                                            <Button x:Name="DiagnosticsButton" Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,8,8" Click="DiagnosticsButton_Click"/>
                                            <Button x:Name="ShowDiagnosticsArchiveButton" Style="{StaticResource GhostButton}" Padding="14,7" Margin="0,0,0,8" IsEnabled="False" Click="ShowDiagnosticsArchiveButton_Click"/>
                                        </WrapPanel>
