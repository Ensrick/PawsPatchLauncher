<Window x:Class="PawsPatchLauncher.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PawsPatchLauncher"
        Title="Paw's Launcher — Launcher update" Width="570" Height="320" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="{StaticResource NightBrush}" FontFamily="Arial" Icon="Assets/K2Launcher.ico">
    <Border Background="{StaticResource NightBrush}" BorderBrush="#60738D" BorderThickness="1" Padding="26,20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="{StaticResource AppMark}" Width="52" Height="52" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Paw's Launcher" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GoldBrightBrush}"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="StagePanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,14">
                <TextBlock x:Name="StageText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel x:Name="TransferPanel" Grid.Row="2">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SizeText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldBrightBrush}"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" IsIndeterminate="True"/>
                <TextBlock x:Name="SpeedText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" MinHeight="17"/>
            </StackPanel>
            <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Foreground="#758AA4" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button x:Name="ContinueButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,8" Visibility="Hidden" IsEnabled="False" Click="Continue_Click"/>
                <Button x:Name="CancelUpdateButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="14,8" Visibility="Collapsed" IsEnabled="False" Click="CancelUpdate_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
