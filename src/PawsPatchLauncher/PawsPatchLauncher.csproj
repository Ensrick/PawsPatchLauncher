<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PawsPatchLauncher</AssemblyName>
    <AssemblyName Condition="'$(LauncherTestName)' != ''">$(LauncherTestName)</AssemblyName>
    <RootNamespace>PawsPatchLauncher</RootNamespace>
    <Version>0.9.7</Version>
    <AssemblyVersion>0.9.7.0</AssemblyVersion>
    <FileVersion>0.9.7.0</FileVersion>
    <ApplicationIcon>Assets\PawsPatch.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants Condition="'$(CommunityChatTestBuild)' == 'true'">$(DefineConstants);COMMUNITY_CHAT_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\RwdTool\RwdTool.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
    <Resource Include="Assets\PawsPatch.ico" />
    <Resource Include="Assets\ChatGlyphs\*.png" />
    <EmbeddedResource Include="launcher.config.json" />
    <EmbeddedResource Include="ThirdPartyNotices.txt" />
    <EmbeddedResource Include="Assets\notification-soft-pluck.wav" />
    <EmbeddedResource Include="Assets\mod-guides.json" />
    <EmbeddedResource Include="Assets\Languages\*.json" />
    <EmbeddedResource Include="Assets\Vanilla1372\autoexec.txt" />
    <EmbeddedResource Include="Assets\Vanilla1372\options_dialog.tgi" />
    <EmbeddedResource Include="Assets\Vanilla1372\*LaunchSettings.bin" />
    <EmbeddedResource Include="Assets\Vanilla1368\*LaunchSettings.bin" />
    <None Update="launcher.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
