<Application x:Class="PawsPatchLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PawsPatchLauncher">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Assets/Brand.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Color x:Key="Night">#07101F</Color>
        <Color x:Key="NightRaised">#0D1B31</Color>
        <Color x:Key="Panel">#132541</Color>
        <Color x:Key="PanelHover">#183052</Color>
        <Color x:Key="Gold">#D7AF56</Color>
        <Color x:Key="GoldBright">#F3D487</Color>
        <Color x:Key="TextMain">#F4F1E7</Color>
        <Color x:Key="TextMuted">#AAB7C9</Color>
        <Color x:Key="Success">#65D89D</Color>
        <Color x:Key="Danger">#F07B72</Color>

        <SolidColorBrush x:Key="NightBrush" Color="{StaticResource Night}"/>
        <SolidColorBrush x:Key="NightRaisedBrush" Color="{StaticResource NightRaised}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHover}"/>
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
        <SolidColorBrush x:Key="GoldBrightBrush" Color="{StaticResource GoldBright}"/>
        <!-- LauncherIcon colour unless an icon sets its own Foreground or sits on a gold button (UseAccent False). -->
        <SolidColorBrush x:Key="LauncherIconAccentBrush" Color="{StaticResource GoldBright}"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>

        <Style TargetType="ContextMenu">
            <Setter Property="local:PopupScrollIsolation.Enabled" Value="True"/>
        </Style>
        <Style x:Key="SocialContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="195"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="MenuSurface" Background="#132541" BorderBrush="#49607D" BorderThickness="1" CornerRadius="8" Padding="5"
                                KeyboardNavigation.DirectionalNavigation="Cycle">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SocialMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface" local:Motion.Background="#132541" CornerRadius="5" Padding="{TemplateBinding Padding}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="MenuIcon" Content="{TemplateBinding Icon}" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="local:Motion.Background" Value="#233C5C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        </Style>

        <Style TargetType="local:LauncherIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="Kind" Value="None"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="#151009"/>
            <Setter Property="local:LauncherIcon.UseAccent" Value="False"/>
            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="local:Motion.HoverBackground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="local:Motion.PressedBackground" Value="#BD963F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="5" local:Motion.Background="{TemplateBinding Background}"
                                local:Motion.BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="{TemplateBinding Padding}">
                            <Grid x:Name="ButtonContent" local:Motion.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <local:LauncherIcon x:Name="ActionIcon" Kind="{Binding Path=(local:LauncherIcon.Kind), RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,9,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                            <local:LauncherIcon x:Name="CopySuccessIcon" Kind="Check" Width="18" Height="18" Foreground="#76DAB0" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="local:Motion.Background" Value="{Binding Path=(local:Motion.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Border" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="local:Motion.Background" Value="{Binding Path=(local:Motion.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="local:Motion.Background" Value="#2B3544"/>
                                <Setter TargetName="Border" Property="local:Motion.BorderBrush" Value="#4B5A6E"/>
                                <Setter Property="Foreground" Value="#8794A7"/>
                                <Setter Property="local:LauncherIcon.UseAccent" Value="False"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="local:ClipboardButton.IsCopySuccessful" Value="True">
                                <Setter TargetName="ButtonContent" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="CopySuccessIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Border" Property="local:Motion.Background" Value="#183C31"/>
                                <Setter TargetName="Border" Property="local:Motion.BorderBrush" Value="#438B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource GoldButton}">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="local:LauncherIcon.UseAccent" Value="True"/>
            <Setter Property="Background" Value="#1D2D45"/>
            <Setter Property="BorderBrush" Value="#49607D"/>
            <Setter Property="local:Motion.HoverBackground" Value="#304867"/>
            <Setter Property="local:Motion.PressedBackground" Value="#243A56"/>
        </Style>

        <Style x:Key="ChatIdentityButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileHeaderButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ProfileSurface" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProfileSurface" Property="local:Motion.Background" Value="#192C44"/><Setter TargetName="ProfileSurface" Property="local:Motion.BorderBrush" Value="#405774"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ProfileSurface" Property="local:Motion.Background" Value="#21364F"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="HelpButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}"/>
            <Setter Property="Background" Value="#243A59"/>
            <Setter Property="BorderBrush" Value="#6F86A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="?"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HelpCircle" CornerRadius="11" local:Motion.Background="{TemplateBinding Background}"
                                local:Motion.BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <local:LauncherIcon Kind="Help" Width="16" Height="16" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpCircle" Property="local:Motion.Background" Value="#3B5375"/>
                                <Setter TargetName="HelpCircle" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HelpCircle" Property="local:Motion.Background" Value="#243A59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HelpCircle" Property="local:Motion.Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="ToggleSwitch">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="SwitchVisual" Width="46" Height="25" Cursor="Hand">
                            <Border x:Name="Track" CornerRadius="13" local:Motion.Background="#35465E" local:Motion.BorderBrush="#60738D" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="19" Height="19" local:Motion.Fill="#E4E8EE" HorizontalAlignment="Left" Margin="3" local:Motion.OffsetX="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="local:Motion.Background" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="Track" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                <Setter TargetName="Thumb" Property="local:Motion.OffsetX" Value="21"/>
                                <Setter TargetName="Thumb" Property="local:Motion.Fill" Value="#241B0E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchVisual" Property="local:Motion.Opacity" Value="0.45"/>
                                <Setter TargetName="SwitchVisual" Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="CheckVisual">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="4" local:Motion.Background="#0A1729" local:Motion.BorderBrush="#60738D" BorderThickness="1">
                                <Path x:Name="CheckMark" Data="M 3,8 L 6,11 L 12,4" Stroke="#241B0E" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" local:Motion.Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="local:Motion.Background" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                                <Setter TargetName="CheckMark" Property="local:Motion.Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="local:Motion.BorderBrush" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckVisual" Property="local:Motion.Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollGrip" TargetType="Thumb">
            <Setter Property="Background" Value="#687C97"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" local:Motion.Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="local:Motion.Background" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="local:Motion.Background" Value="{StaticResource GoldBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Grip" Property="local:Motion.Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="local:SmoothScroll.Enabled" Value="True"/>
        </Style>
        <!-- Native thumb dragging remains direct; wheel and paging use eased pixel scrolling. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="#0A1729"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border x:Name="ScrollRail" local:Motion.Background="{TemplateBinding Background}" local:Motion.BorderBrush="#243A59"
                                BorderThickness="1" CornerRadius="6" Width="13" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageBefore" Style="{StaticResource ScrollPageButton}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" Style="{StaticResource ScrollGrip}" MinHeight="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageAfter" Style="{StaticResource ScrollPageButton}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollRail" Property="local:Motion.BorderBrush" Value="#4B6483"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="ScrollRail" Property="Width" Value="Auto"/>
                                <Setter TargetName="ScrollRail" Property="Height" Value="13"/>
                                <Setter TargetName="ScrollRail" Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter TargetName="ScrollRail" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PageBefore" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="PageAfter" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/>
                                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="13"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Background" Value="#172E47"/>
            <Setter Property="BorderBrush" Value="#8E784A"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Padding" Value="12,9"/>
            <EventSetter Event="Loaded" Handler="Tooltip_Loaded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="Background" Value="#263A55"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="VolumeTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
                <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NotificationVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#D5AE52" Style="{StaticResource VolumeTrackButton}"/></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#3C526D" Style="{StaticResource VolumeTrackButton}"/></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Ellipse x:Name="Dot" Fill="#E4C777" Stroke="#FFE7A8" StrokeThickness="1"/>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFF0C1"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ResourceDictionary>
    </Application.Resources>
</Application>
